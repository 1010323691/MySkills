#!/usr/bin/python3
"""Reuse tools per project and safely restart exited tool panes."""
import os, sys, shlex, subprocess, fcntl
from pathlib import Path
sys.path.insert(0, str(Path.home()/'.local/lib/terminal-workbench'))
from workbench_context import resolve, git_info, tm
home = Path.home()


def program(kind):
    return ['lazygit'] if kind == 'git' else [str(home/'.local/bin/btm'), '-C', str(home/'.config/bottom/bottom.toml')]


def main():
    if len(sys.argv) > 2 and sys.argv[1] == '--run':
        kind = sys.argv[2]
        if kind not in {'git', 'monitor'}:
            raise RuntimeError('Unknown tool')
        # Set this before exec: q/Ctrl+C leaves a safely restartable dead pane.
        subprocess.run(['tmux', 'set-option', '-p', '-t', os.environ['TMUX_PANE'], 'remain-on-exit', 'on'], check=True)
        os.execvp(program(kind)[0], program(kind))
    kind = sys.argv[1] if len(sys.argv) > 1 else ''
    if kind not in {'git', 'monitor'}:
        raise RuntimeError('Usage: terminal-tool git|monitor [directory] [pane]')
    pane = sys.argv[3] if len(sys.argv) > 3 else os.environ.get('TMUX_PANE', '')
    if not pane:
        raise RuntimeError('Run this helper inside tmux')
    context = resolve(pane)
    cwd = context['cwd']
    info = git_info(cwd, with_changes=False) if kind == 'git' else None
    if kind == 'git' and info is None:
        tm('display-message', 'Current directory is not a Git repository')
        return
    root = info['root'] if info else cwd
    session = context['session']
    cache = home/'.cache/terminal-workbench'
    cache.mkdir(parents=True, exist_ok=True)
    with (cache/'tools.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        rows = tm('list-panes', '-s', '-t', session, '-F',
                  '#{window_id}\t#{pane_id}\t#{window_name}\t#{@work-tool}\t#{@work-tool-root}\t#{pane_dead}\t#{pane_current_command}\t#{pane_start_command}\t#{pane_current_path}')
        match = None
        for row in rows.splitlines():
            fields = row.split('\t')
            if len(fields) != 9:
                continue
            window, target, name, tool, tool_root, dead, command, start, tool_cwd = fields
            if tool == kind and (kind == 'monitor' or tool_root == root):
                match = (window, target, dead)
                break
            # Retired legacy wrappers leave a usable shell: label it honestly.
            legacy_wrapper = ('.local/bin/btm' in start if kind == 'monitor' else start.startswith('lazygit;'))
            if not tool and name == kind and command in {'bash', 'zsh', 'fish', 'sh'} and legacy_wrapper:
                tm('rename-window', '-t', window, 'shell')
            # Adopt a still-running legacy tool only if its project is correct.
            expected = 'lazygit' if kind == 'git' else 'btm'
            if not tool and name == kind and command == expected:
                legacy = git_info(tool_cwd, with_changes=False) if kind == 'git' else None
                if kind == 'monitor' or (legacy and legacy['root'] == root):
                    # Keep its origin for shortcuts launched from inside the tool.
                    tm('set-option', '-w', '-t', window, '@work-source-window', context['source'])
                    tm('set-option', '-w', '-t', window, '@work-tool-root', root)
                    # Legacy wrappers return to a shell; don't respawn or kill it.
                    tm('select-window', '-t', window)
                    return
        launch = shlex.join([str(home/'.local/bin/terminal-tool'), '--run', kind])
        if match:
            window, target, dead = match
            if dead == '1':
                subprocess.run(['tmux', 'respawn-pane', '-t', target, '-c', root, launch], check=True)
        else:
            created = subprocess.check_output(['tmux', 'new-window', '-d', '-P', '-F', '#{window_id}\t#{pane_id}',
                                               '-t', session, '-n', kind, '-c', root, launch], text=True).strip()
            window, target = created.split('\t')
        for key, value in {'@work-tool': kind, '@work-tool-root': root, '@work-source-window': context['source']}.items():
            subprocess.run(['tmux', 'set-option', '-w', '-t', window, key, value], check=True)
        tm('select-window', '-t', window)


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        print(str(exc), file=sys.stderr)
        sys.exit(1)
