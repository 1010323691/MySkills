#!/usr/bin/python3
"""Open on-demand Git/monitor windows; never runs a project service automatically."""
import subprocess,sys,os,shlex
from pathlib import Path
kind=sys.argv[1] if len(sys.argv)>1 else ''
if kind not in ('git','monitor'):sys.exit('Usage: terminal-tool git|monitor [directory]')
cwd=sys.argv[2] if len(sys.argv)>2 else os.getcwd()
pane=sys.argv[3] if len(sys.argv)>3 else os.environ.get('TMUX_PANE','')
if pane:
 try:
  main=subprocess.check_output(['tmux','display-message','-p','-t',pane,'#{@work-main}'],text=True).strip()
  if main:cwd=subprocess.check_output(['tmux','display-message','-p','-t',main,'#{pane_current_path}'],text=True).strip()
 except subprocess.SubprocessError:pass
if kind=='git' and subprocess.run(['git','-C',cwd,'rev-parse','--git-dir'],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode:
 subprocess.run(['tmux','display-message','Current directory is not a Git repository']);sys.exit(0)
pane=sys.argv[3] if len(sys.argv)>3 else os.environ.get('TMUX_PANE','')
query=['tmux','display-message','-p']
if pane:query+=['-t',pane]
query+=['#{session_id}']
session=subprocess.check_output(query,text=True).strip()
windows=subprocess.check_output(['tmux','list-windows','-t',session,'-F','#{window_id}\t#{window_name}'],text=True)
existing=next((line.split('\t')[0] for line in windows.splitlines() if line.split('\t')[1]==kind),None)
if existing:subprocess.run(['tmux','select-window','-t',existing],check=True)
else:
 program=['lazygit'] if kind=='git' else [str(Path.home()/'.local/bin/btm'),'-C',str(Path.home()/'.config/bottom/bottom.toml')]
 # Exiting the tool leaves a useful shell in its window.
 command=shlex.join(program)+'; exec /bin/bash -l'
 subprocess.run(['tmux','new-window','-t',session,'-n',kind,'-c',cwd,command],check=True)
