#!/usr/bin/python3
"""Generate the coordinated theme from one palette; reload tmux without restarting it."""
from pathlib import Path
import tomllib,subprocess,json,os
home=Path.home()
p=tomllib.loads((home/'.config/terminal-workbench/palette.toml').read_text())
def write(rel,text):
 target=home/rel;target.parent.mkdir(parents=True,exist_ok=True);target.write_text(text)
colors=[p['foreground'],p['error'],p['success'],p['yellow'],p['blue'],p['purple'],p['cyan'],p['muted'],p['muted'],p['accent'],p['success'],p['yellow'],p['blue'],p['purple'],p['cyan'],'#5C574C']
theme=f"background = {p['background']}\nforeground = {p['foreground']}\ncursor-color = {p['accent']}\ncursor-text = {p['background']}\nselection-background = {p['selection']}\nselection-foreground = {p['foreground']}\n"
theme+=''.join(f'palette = {i}={color}\n' for i,color in enumerate(colors))
write('.config/ghostty/themes/Claude Cream',theme)
import re
config=home/'.config/ghostty/config'
if config.exists():
 text=re.sub(r'^font-family = .*$',lambda m:'font-family = '+p['font'],config.read_text(),flags=re.M)
 text=re.sub(r'^split-divider-color = .*$',lambda m:'split-divider-color = '+p['border'],text,flags=re.M)
 config.write_text(text)
write('.config/tmux/claude-colors.conf',f'''# Generated by terminal-theme.
set -g status-style "bg={p['surface']},fg={p['foreground']}"
set -g status-left '#[fg={p['accent']},bold] #("$HOME/.local/bin/terminal-status" "#{{pane_id}}") › #[default]'
set -g status-right "#[fg={p['muted']}]%H:%M "
setw -g window-status-style "fg={p['muted']},bg={p['surface']}"
setw -g window-status-current-style "fg={p['accent']},bg={p['selection']},bold"
set -g pane-border-style "fg={p['border']}"
set -g pane-active-border-style "fg={p['accent']}"
set -g message-style "fg={p['foreground']},bg={p['selection']}"
setw -g mode-style "fg={p['foreground']},bg={p['selection']}"
''')
write('.config/starship.toml',f'''# Generated from ~/.config/terminal-workbench/palette.toml
add_newline = true
command_timeout = 500
scan_timeout = 30
format = "$username$hostname$directory$git_branch$git_status$python$cmd_duration$line_break$character"
[username]
show_always = false
style_user = "{p['muted']}"
style_root = "bold {p['error']}"
format = "[$user@]($style)"
[hostname]
ssh_only = true
style = "bold {p['accent']}"
format = "[ssh:$hostname ]($style)"
[directory]
style = "bold {p['foreground']}"
format = "[$path]($style) "
truncation_length = 3
truncation_symbol = "…/"
[git_branch]
symbol = " "
style = "{p['accent']}"
format = "[$symbol$branch]($style) "
[git_status]
style = "{p['muted']}"
format = "([$all_status$ahead_behind]($style) )"
[python]
style = "{p['success']}"
format = "[ $virtualenv]($style) "
[cmd_duration]
min_time = 3000
style = "{p['muted']}"
format = "[$duration]($style) "
[character]
success_symbol = "[❯](bold {p['accent']})"
error_symbol = "[❯](bold {p['error']})"
''')
fzf_colors=f"bg:{p['background']},bg+:{p['selection']},fg:{p['foreground']},fg+:{p['foreground']},hl:{p['accent']},hl+:{p['accent']},info:{p['muted']},prompt:{p['accent']},pointer:{p['accent']},marker:{p['success']},spinner:{p['accent']},header:{p['muted']},border:{p['border']}"
write('.config/terminal-workbench/colors.bash',"export FZF_DEFAULT_OPTS='--height=65% --layout=reverse --border=rounded --info=inline --color="+fzf_colors+"'\n")
write('.config/bat/config','--theme=ansi\n--style=numbers,changes,header\n')
write('.config/lazygit/config.yml',f'''gui:
  theme:
    activeBorderColor: ["{p['accent']}", bold]
    inactiveBorderColor: ["{p['border']}"]
    optionsTextColor: ["{p['blue']}"]
    selectedLineBgColor: ["{p['selection']}"]
    defaultFgColor: ["{p['foreground']}"]
    searchingActiveBorderColor: ["{p['accent']}", bold]
  nerdFontsVersion: "3"
  showRandomTip: false
  showBottomLine: false
''')
# Every generated color is derived from the current palette, on every run.
micro={
 'default':('foreground','background'), 'comment':('muted','background'),
 'constant':('yellow','background'), 'constant.string':('success','background'),
 'identifier':('blue','background'), 'statement':('accent','background'),
 'symbol':('muted','background'), 'preproc':('purple','background'),
 'type':('accent','background'), 'special':('cyan','background'),
 'error':('error','background'), 'todo':('accent','background'),
 'hlsearch':('foreground','selection'), 'statusline':('foreground','surface'),
 'tabbar':('foreground','surface'), 'line-number':('muted','background'),
 'current-line-number':('accent','background'), 'selection':('foreground','selection'),
 'match-brace':('accent','selection'), 'gutter-error':('error','background'),
 'gutter-warning':('yellow','background')}
write('.config/micro/colorschemes/claude-cream.micro',''.join(f'color-link {key} "{p[a]},{p[b]}"\n' for key,(a,b) in micro.items())+'color-link cursor-line "'+p['surface']+'"\n')
base=home/'.config/terminal-workbench/bottom-layout.toml'
if not base.exists():
 current=(home/'.config/bottom/bottom.toml').read_text()
 import re
 current=re.sub(r'(?ms)^\[styles(?:\.[^]]+)?\]\n.*?(?=^\[|\Z)','',current)
 base.write_text(current)
styles=f'''[styles]
theme = "default-light"
[styles.cpu]
all_entry_color = "{p['accent']}"
avg_entry_color = "{p['success']}"
cpu_core_colors = ["{p['accent']}", "{p['blue']}", "{p['success']}", "{p['purple']}", "{p['yellow']}", "{p['cyan']}"]
[styles.memory]
ram_color = "{p['purple']}"
swap_color = "{p['yellow']}"
[styles.network]
rx_color = "{p['blue']}"
tx_color = "{p['success']}"
[styles.tables]
headers = {{color = "{p['accent']}", bold = true}}
[styles.graphs]
graph_color = "{p['border']}"
legend_text = {{color = "{p['muted']}"}}
[styles.widgets]
border_color = "{p['muted']}"
selected_border_color = "{p['accent']}"
widget_title = {{color = "{p['foreground']}"}}
text = {{color = "{p['foreground']}"}}
selected_text = {{color = "{p['foreground']}", bg_color = "{p['selection']}"}}
disabled_text = {{color = "{p['muted']}"}}
'''
write('.config/bottom/bottom.toml',base.read_text()+'\n'+styles)
path=home/'.config/fastfetch/config.jsonc'
if path.exists():
 import re
 rgb='38;2;'+';'.join(str(int(p['accent'][i:i+2],16)) for i in (1,3,5))
 text=re.sub(r'("keys"\s*:\s*")[^"]*',lambda m:m[1]+rgb,path.read_text())
 text=re.sub(r'("1"\s*:\s*")38;2;[^"\n]*',lambda m:m[1]+rgb,text)
 path.write_text(text)
import os
if os.environ.get('TERMINAL_THEME_NO_RELOAD') != '1':
 subprocess.run(['tmux','source-file',str(home/'.config/tmux/claude-colors.conf')],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
print('Theme generated. Reload Ghostty with Ctrl+Shift+R; new shells load the prompt and fzf colors.')
