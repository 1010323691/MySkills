#!/usr/bin/python3
"""Read-only files and Git summary, following the main Agent workspace."""
import os, sys, time, shutil, unicodedata, signal, tomllib
from pathlib import Path
sys.path.insert(0, str(Path.home()/'.local/lib/terminal-workbench'))
from workbench_context import resolve, git_info, files, clean, tm

home = Path.home()
reset = '\033[0m'


def fit(text, width):
    result = ''
    used = 0
    for char in clean(text):
        size = 0 if unicodedata.combining(char) else (2 if unicodedata.east_asian_width(char) in 'WF' else 1)
        if used + size > width:
            return fit(result, max(0, width-1)) + '…' if width else ''
        result += char
        used += size
    return result



def change_label(item):
    code = item['code']
    if item['conflict']:
        return '冲突'
    if code == '??':
        return '新增'
    if code[0] != ' ' and code[1] != ' ':
        return '暂存后又改动'
    state = '已暂存' if code[0] != ' ' else '未暂存'
    kind = next((label for symbol, label in [('R', '重命名'), ('C', '复制'), ('D', '删除'), ('A', '新增'), ('T', '类型变更')] if symbol in code), '修改')
    return state + '·' + kind


def draw(window):
    palette = tomllib.loads((home/'.config/terminal-workbench/palette.toml').read_text())
    def color(key):
        value = palette[key].lstrip('#')
        return '\033[38;2;' + ';'.join(str(int(value[i:i+2], 16)) for i in (0, 2, 4)) + 'm'
    accent, muted, ink = color('accent'), color('muted'), color('foreground')
    width, height = shutil.get_terminal_size((50, 44))
    usable = max(1, width-4)
    available = max(1, height-1)
    def line(text, style=ink):
        return '  ' + style + fit(text, usable) + reset
    main = tm('show-options', '-wv', '-t', window, '@work-main')
    try:
        cwd = resolve(main or window)['cwd']
    except RuntimeError:
        cwd = str(home)
    info = git_info(cwd)
    # Label the primary window by the actual foreground program, without renaming it.
    command = tm('display-message', '-p', '-t', main or window, '#{pane_current_command}')
    role = 'shell' if command in {'bash', 'zsh', 'fish', 'sh', 'dash'} else ('agent' if command in {'command-code', 'cmd', 'codex', 'claude', 'opencode', 'aider', 'gemini'} else command or 'shell')
    if tm('show-options', '-wv', '-t', window, '@work-role') != role:
        tm('set-option', '-w', '-t', window, '@work-role', role)
    branch = line('分支  ' + info['branch'], accent) if info else line('当前目录未使用 Git', muted)
    stats = []
    changes = []
    if info:
        if info['error']:
            stats = [line('Git 状态读取失败，稍后重试', muted)]
        else:
            stats = [line(f"待提交 {len(info['changes'])} 个文件" if info['changes'] else '工作区干净，无待提交改动', accent),
                     line(f"已暂存 {info['staged']} · 未暂存 {info['modified']}", muted),
                     line(f"新增 {info['untracked']} · 冲突 {info['conflicts']}", accent if info['conflicts'] else muted)]
            changes = [line('[' + change_label(item) + '] ' + item['path'], accent if item['conflict'] else ink) for item in info['changes'][:4]]
    keys = [line('Ctrl+b f  查找文件', muted), line('Ctrl+b p  切换项目', muted),
            line('Ctrl+b g  审查改动', muted), line('Ctrl+b m  系统监控', muted)]
    host = [line('本机  ' + os.uname().nodename, muted)]
    heading = [line('项目状态', muted)]
    def context(compact=False):
        core = heading + ([] if compact else ['']) + [branch] + stats + changes + host + ([] if compact else ['']) + keys
        return core if compact else ['', line('─'*usable, muted), ''] + core
    compact = available < 4 + len(context()) + 3
    if compact:
        host = []
    header_size = 4
    while changes and available < header_size + len(context(compact)) + 2:
        changes.pop()
    if available < header_size + len(context(compact)):
        header_size = 2
    if available < header_size + len(context(compact)) and info and not info['error']:
        stats = [line(f"暂存{info['staged']} 未暂存{info['modified']} 新增{info['untracked']} 冲突{info['conflicts']}", muted)]
    footer = context(compact)
    budget = max(0, available-header_size-len(footer))
    listing = []
    try:
        entries = files(cwd, info)
        count = max(0, budget-1) if len(entries) > budget else len(entries)
        for entry, generated, changed in entries[:count]:
            directory = entry.is_dir(follow_symlinks=False)
            style = muted if generated else (accent if changed or directory else ink)
            label = ('* ' if changed else '') + (' ' if directory else ' ') + entry.name + ('/' if directory else '')
            listing.append(line(label, style))
        if len(entries) > count and budget:
            listing.append(line(f'… 还有 {len(entries)-count} 项', muted))
    except OSError:
        if budget:
            listing = [line('目录暂时不可访问', muted)]
    short = '~' + cwd[len(str(home)):] if cwd == str(home) or cwd.startswith(str(home)+'/') else cwd
    if len(short) > usable:
        short = '…/' + '/'.join(Path(cwd).parts[-2:])
    header = ['', line('项目文件', muted), line(short, accent), '']
    if header_size == 2:
        header = header[1:3]
    rows = header + listing + footer
    if len(rows) > available:
        rows = footer[:available]
    return '\033[?2026h\033[H' + ''.join('\033[2K'+row+'\r\n' for row in rows) + '\033[J\033[?2026l'


def main():
    stop = False
    def ending(*_):
        nonlocal stop
        stop = True
    signal.signal(signal.SIGTERM, ending)
    signal.signal(signal.SIGINT, ending)
    try:
        sys.stdout.write('\033[?25l\033[2J')
        while not stop:
            sys.stdout.write(draw(sys.argv[1]))
            sys.stdout.flush()
            time.sleep(2)
    finally:
        sys.stdout.write('\033[0m\033[?25h\033[?2026l')
        sys.stdout.flush()


if __name__ == '__main__':
    main()
