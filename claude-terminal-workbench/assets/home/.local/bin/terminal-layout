#!/usr/bin/python3
"""Maintain a useful left/right proportion after the client is resized."""
import subprocess,sys
try:
 args=['tmux','list-windows','-F','#{window_id}\t#{window_width}\t#{@work-sidebar}\t#{@work-main}']
 if len(sys.argv)>1:args+=['-t',sys.argv[1]]
 rows=subprocess.check_output(args,text=True).splitlines()
 for row in rows:
  window,width,side,main=row.split('\t');width=int(width)
  if side and main:
   left=min(max(24,int(width*.30)),max(12,width-35))
   subprocess.run(['tmux','resize-pane','-t',side,'-x',str(left)],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
except (subprocess.SubprocessError,ValueError):pass
