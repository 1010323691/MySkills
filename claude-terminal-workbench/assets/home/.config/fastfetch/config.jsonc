{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "ubuntu_small",
    "padding": {
      "right": 3,
      "top": 2
    },
    "color": {
      "1": "38;2;169;80;50",
      "2": "38;2;147;102;34"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;169;80;50",
      "title": "38;2;82;107;61"
    },
    "key": {
      "width": 15
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│  distro",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "│  kernel"
    },
    {
      "type": "uptime",
      "key": "│  uptime"
    },
    {
      "type": "de",
      "key": "│  desktop"
    },
    {
      "type": "terminal",
      "key": "│  term"
    },
    {
      "type": "shell",
      "key": "│  shell"
    },
    {
      "type": "cpu",
      "key": "│  cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 gpu",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│  memory"
    },
    {
      "type": "disk",
      "key": "│  disk",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
