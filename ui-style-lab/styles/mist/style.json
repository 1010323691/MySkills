    "examples": "examples.html",
    "documentation": "notes.md",
    "tokens": "tokens.css",
    "styles": "component.css",
    "interactions": "component.js",
    "narrifyAdmin": "narrify-admin.html",
    "narrifyStyles": "narrify-admin.css",
    "whiteMaterial": "white-material.html"
  },
  "files": {
    "library": [
      "tokens.css",
      "component.css",
      "component.js",
      "narrify-admin.css"
    ],
    "showcase": [
      "demo.html",
      "demo.css",
